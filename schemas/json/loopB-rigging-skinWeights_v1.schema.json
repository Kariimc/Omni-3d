{
  "$ref": "#/definitions/loopB.rigging.skinWeights/v1",
  "definitions": {
    "loopB.rigging.skinWeights/v1": {
      "type": "object",
      "properties": {
        "$omni3d": {
          "type": "string",
          "const": "loopB.rigging.skinWeights/v1"
        },
        "jobId": {
          "type": "string",
          "pattern": "^job_[A-Za-z0-9]+$"
        },
        "loop": {
          "type": "string",
          "const": "B_rigging"
        },
        "input": {
          "type": "object",
          "properties": {
            "retopoMesh": {
              "type": "string",
              "pattern": "^asset:\\/\\/.+"
            },
            "vertices": {
              "type": "integer"
            }
          },
          "required": [
            "retopoMesh",
            "vertices"
          ],
          "additionalProperties": false
        },
        "rigStandard": {
          "type": "string",
          "enum": [
            "ue5_sk_mannequin",
            "unity_humanoid_mecanim"
          ]
        },
        "jointPrediction": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string"
            },
            "voxelGrid": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "model",
            "voxelGrid",
            "confidence"
          ],
          "additionalProperties": false
        },
        "skeleton": {
          "type": "object",
          "properties": {
            "root": {
              "type": "string"
            },
            "boneCount": {
              "type": "integer"
            },
            "namingConvention": {
              "type": "string"
            },
            "bones": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "parent": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "head": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  },
                  "tail": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  }
                },
                "required": [
                  "name",
                  "parent",
                  "head",
                  "tail"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "root",
            "boneCount",
            "namingConvention",
            "bones"
          ],
          "additionalProperties": false
        },
        "skinWeighting": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string"
            },
            "maxInfluencesPerVertex": {
              "type": "integer"
            },
            "normalized": {
              "type": "boolean"
            },
            "sample": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "vertex": {
                    "type": "integer"
                  },
                  "influences": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "bone": {
                          "type": "string"
                        },
                        "weight": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "bone",
                        "weight"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "vertex",
                  "influences"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "method",
            "maxInfluencesPerVertex",
            "normalized",
            "sample"
          ],
          "additionalProperties": false
        },
        "nextStage": {
          "type": "string",
          "const": "loopB.animationRetarget"
        }
      },
      "required": [
        "$omni3d",
        "jobId",
        "loop",
        "input",
        "rigStandard",
        "jointPrediction",
        "skeleton",
        "skinWeighting",
        "nextStage"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
