# Omni3D API
PORT=8787
HOST=0.0.0.0

# Event broadcaster across multiple API instances:
#   "memory"   (default, single instance)
#   "pg"       Postgres LISTEN/NOTIFY  (needs DATABASE_URL, direct/session connection)
#   "supabase" Supabase Realtime       (needs SUPABASE_URL + SUPABASE_SERVICE_KEY)
EVENT_BUS=memory
DATABASE_URL=

# Supabase persistence (optional).
# If both are set, the API uses Supabase; otherwise it falls back to in-memory.
# Use the service-role key — server-side only, never ship to a client.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
